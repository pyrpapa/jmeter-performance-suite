          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Re-auth on 401">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
if (prev.getResponseCode() == &quot;401&quot;) {
    log.info(&quot;401 - re-authenticating thread &quot; + ctx.getThreadNum())
    def client = org.apache.http.impl.client.HttpClients.createDefault()
